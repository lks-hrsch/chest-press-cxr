export VLLM_TARGET_DEVICE=cuda

# Disable FlashInfer sampler: models decode greedily (temperature=0) so the native
# PyTorch sampler is bit-identical and requires no runtime nvcc JIT compilation.
# export VLLM_USE_FLASHINFER_SAMPLER=0

# Keep all caches/checkpoints off $HOME
export HF_HOME=/data/horse/ws/luhi161d-custom-huggingface-cache/hf_home
export HF_CACHE_DIR=/data/horse/ws/luhi161d-custom-huggingface-cache/hf_cache_dir
export TRANSFORMERS_CACHE=/data/horse/ws/luhi161d-custom-huggingface-cache/hf_cache
export HF_DATASETS_CACHE=/data/horse/ws/luhi161d-custom-huggingface-cache/hf_datasets

# speed up uploads to the Hub if you push artifacts later
export HF_HUB_ENABLE_HF_TRANSFER=1

# uv: /tmp and /data/horse are on different filesystems — hardlinks not supported
export UV_LINK_MODE=copy